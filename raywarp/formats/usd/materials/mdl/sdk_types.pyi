"""Types of the MDL SDK bindings (`raywarp._native.mdl.pymdlsdk`, untyped SWIG classes): the subset
raywarp calls, as Protocols. A stub-only module: imported for type checking; at run time the
classes come from the bindings (`sdk.Api.bindings`)."""

from typing import NewType, Protocol

import numpy as np

ScopeId = NewType("ScopeId", str)

class Interface(Protocol):
  """An SDK interface handle (a failed call returns an invalid one, or None)."""

  def is_valid_interface(self) -> bool: ...

class Named(Protocol):
  """An SDK enum value (`IExpression.Kind`, `IValue.Kind`, `IType.Kind`): compared by name."""

  @property
  def name(self) -> str: ...

class IString(Interface, Protocol):
  def get_c_str(self) -> str: ...

class IMessage(Protocol):
  def get_string(self) -> str: ...

class IMdl_execution_context(Protocol):
  def set_option(self, name: str, value: bool | float | str) -> int: ...
  def get_error_messages_count(self) -> int: ...
  def get_error_message(self, index: int) -> IMessage: ...

class IType(Protocol):
  def get_kind(self) -> Named: ...
  def skip_all_type_aliases(self) -> IType: ...
  def get_interface[T](self, type: type[T]) -> T: ...

class IType_enumeration(Protocol):
  def find_value(self, code_or_name: int | str) -> int: ...

class IType_vector(Protocol):
  def get_size(self) -> int: ...
  def get_element_type(self) -> IType: ...

class IType_list(Protocol):
  def get_size(self) -> int: ...
  def get_name(self, index: int) -> str: ...
  def get_type(self, name: str) -> IType: ...

class IValue(Protocol):
  def get_kind(self) -> Named: ...
  def get_interface[T](self, type: type[T]) -> T: ...

class IValue_atomic(Protocol):
  def get_value(self) -> float | str: ...

class IValue_enumeration(Protocol):
  def get_name(self) -> str: ...

class IValue_compound(IValue, Protocol):
  def get_size(self) -> int: ...
  def get_value(self, index: int) -> IValue: ...
  def set_value(self, index: int, value: IValue) -> int: ...

class IValue_texture(Protocol):
  def get_value(self) -> str: ...
  def get_file_path(self) -> str | None: ...

class IValue_resource(Protocol):
  def get_value(self) -> str | None: ...
  def get_file_path(self) -> str | None: ...

class IValue_factory(Protocol):
  def create_bool(self, value: bool) -> IValue: ...
  def create_int(self, value: int) -> IValue: ...
  def create_float(self, value: float) -> IValue: ...
  def create_double(self, value: float) -> IValue: ...
  def create_string(self, value: str) -> IValue: ...
  def create_color(self, red: float, green: float, blue: float) -> IValue: ...
  def create_enum(self, type: IType_enumeration, index: int) -> IValue: ...
  def create_vector(self, type: IType_vector) -> IValue_compound: ...
  def create_texture(self, type: IType, value: str) -> IValue: ...
  def create(self, type: IType) -> IValue: ...

class IExpression(Interface, Protocol):
  def get_kind(self) -> Named: ...
  def get_interface[T](self, type: type[T]) -> T: ...

class IExpression_list(Protocol):
  def get_size(self) -> int: ...
  def get_name(self, index: int) -> str: ...
  def get_expression(self, index: int) -> IExpression: ...
  def get_index(self, name: str) -> int: ...
  def add_expression(self, name: str, expression: IExpression) -> int: ...

class IExpression_constant(Protocol):
  def get_value(self) -> IValue: ...

class IExpression_direct_call(Protocol):
  def get_definition(self) -> str: ...
  def get_arguments(self) -> IExpression_list: ...

class IExpression_temporary(Protocol):
  def get_index(self) -> int: ...

class IExpression_factory(Protocol):
  def create_constant(self, value: IValue) -> IExpression: ...
  def create_expression_list(self) -> IExpression_list: ...

class ICompiled_material(Interface, Protocol):
  def get_body(self) -> IExpression: ...
  def get_temporary(self, index: int) -> IExpression: ...
  def lookup_sub_expression(self, path: str) -> IExpression | None: ...
  def get_sub_expression_hash(self, path: str) -> Uuid: ...

class Uuid(Protocol):
  m_id1: int
  m_id2: int
  m_id3: int
  m_id4: int

class IMaterial_instance(Protocol):
  def create_compiled_material(self, flags: int, context: IMdl_execution_context) -> ICompiled_material | None: ...

class IFunction_call(Interface, Protocol):
  def get_interface[T](self, type: type[T]) -> T: ...

class ReturnCode(Protocol):
  value: int

class IFunction_definition(Interface, Protocol):
  def is_uniform(self) -> bool: ...
  def get_semantic(self) -> Named: ...
  def get_parameter_index(self, name: str) -> int: ...
  def get_parameter_types(self) -> IType_list: ...
  def get_defaults(self) -> IExpression_list: ...
  def create_function_call(self, arguments: IExpression_list, errors: ReturnCode) -> IFunction_call | None: ...

class IModule(Interface, Protocol):
  def get_filename(self) -> str: ...
  def get_mdl_name(self) -> str: ...
  def get_material_count(self) -> int: ...
  def get_material(self, index: int) -> str: ...
  def get_import_count(self) -> int: ...
  def get_import(self, index: int) -> str: ...

class IImage(Interface, Protocol):
  def reset_file(self, filename: str) -> int: ...
  def resolution_x(self, frame_id: int, uvtile_id: int, level: int) -> int: ...
  def resolution_y(self, frame_id: int, uvtile_id: int, level: int) -> int: ...
  def get_filename(self, frame_id: int, uvtile_id: int) -> str: ...
  def set_from_canvas(self, canvas: ICanvas) -> bool: ...
  def get_type(self, frame_id: int, uvtile_id: int) -> str: ...
  def get_frame_length(self, frame_id: int) -> int: ...

class ITexture(Interface, Protocol):
  def set_image(self, name: str) -> int: ...
  def get_image(self) -> str: ...
  def set_gamma(self, gamma: float) -> None: ...
  def get_effective_gamma(self, frame_id: int, uvtile_id: int) -> float: ...

class IScope(Protocol):
  def create_transaction(self) -> ITransaction: ...
  def get_id(self) -> ScopeId: ...

class ITransaction(Protocol):
  def access_as[T](self, type: type[T], name: str) -> T | None: ...
  def create_as[T](self, type: type[T], type_name: str) -> T: ...
  def store(self, element: IImage | ITexture, name: str) -> int: ...
  def commit(self) -> int: ...

class IDatabase(Protocol):
  def get_global_scope(self) -> IScope: ...
  def create_scope(self, parent: IScope, privacy_level: int) -> IScope: ...
  def remove_scope(self, id: ScopeId) -> int: ...

class IMdl_configuration(Protocol):
  def add_mdl_path(self, path: str) -> int: ...
  def clear_mdl_paths(self) -> None: ...
  def add_resource_path(self, path: str) -> int: ...
  def clear_resource_paths(self) -> None: ...

class IMdl_impexp_api(Protocol):
  def load_module(self, transaction: ITransaction, argument: str, context: IMdl_execution_context) -> int: ...

class IMdl_factory(Protocol):
  def create_execution_context(self) -> IMdl_execution_context: ...
  def get_db_module_name(self, mdl_name: str) -> IString | None: ...
  def create_value_factory(self, transaction: ITransaction) -> IValue_factory: ...
  def create_expression_factory(self, transaction: ITransaction) -> IExpression_factory: ...

class ITile(Protocol):
  def get_data_numpy(self) -> np.ndarray[tuple[int, ...], np.dtype[np.float32]]: ...

class ICanvas(Protocol):
  def get_tile(self) -> ITile: ...

class IImage_api(Protocol):
  def create_canvas(self, pixel_type: str, width: int, height: int) -> ICanvas: ...

class IBaker(Interface, Protocol):
  def get_pixel_type(self) -> str: ...
  def bake_texture(
    self, canvas: ICanvas, min_u: float, max_u: float, min_v: float, max_v: float, animation_time: float, samples: int
  ) -> int: ...

class IMdl_distiller_api(Protocol):
  def distill_material(
    self, material: ICompiled_material, target: str, distiller_options: None, errors: ReturnCode
  ) -> ICompiled_material | None: ...
  def create_baker(self, material: ICompiled_material, path: str, resource: Named) -> IBaker | None: ...

class INeuray(Protocol):
  def get_api_component[T](self, type: type[T]) -> T: ...
  def start(self) -> int: ...
  def shutdown(self) -> int: ...

class Bindings(Protocol):
  """`raywarp._native.mdl.pymdlsdk`: the interface classes passed to `get_interface` /
  `access_as` / `get_api_component` and the few enums and factories used."""

  IDatabase: type[IDatabase]
  IMdl_configuration: type[IMdl_configuration]
  IMdl_impexp_api: type[IMdl_impexp_api]
  IMdl_factory: type[IMdl_factory]
  IMdl_distiller_api: type[IMdl_distiller_api]
  IImage_api: type[IImage_api]
  IModule: type[IModule]
  IFunction_definition: type[IFunction_definition]
  IMaterial_instance: type[IMaterial_instance]
  IImage: type[IImage]
  ITexture: type[ITexture]
  IType_enumeration: type[IType_enumeration]
  IType_vector: type[IType_vector]
  IValue_bool: type[IValue_atomic]
  IValue_int: type[IValue_atomic]
  IValue_float: type[IValue_atomic]
  IValue_double: type[IValue_atomic]
  IValue_string: type[IValue_atomic]
  IValue_compound: type[IValue_compound]
  IValue_enumeration: type[IValue_enumeration]
  IValue_texture: type[IValue_texture]
  IValue_resource: type[IValue_resource]
  IExpression_constant: type[IExpression_constant]
  IExpression_direct_call: type[IExpression_direct_call]
  IExpression_temporary: type[IExpression_temporary]

  def ReturnCode(self) -> ReturnCode: ...
