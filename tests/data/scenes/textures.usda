    def DistantLight "Sun"
    {
        bool inputs:normalize = 1
        float inputs:intensity = 40000
        float inputs:angle = 0.53
        float3 xformOp:rotateXYZ = (60, 0, -35)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    def DomeLight "Sky"
    {
        custom int omni:rtx:usdluxVersion = 2411
        float inputs:intensity = 3000
        color3f inputs:color = (0.8, 0.9, 1)
    }

    def Camera "View0"
    {
        matrix4d xformOp:transform = ((1, 0, 0, 0), (0, 0.0192272, 0.999815, 0), (0, -0.999815, 0.0192272, 0), (0, -2.6, 0.8, 1))
        uniform token[] xformOpOrder = ["xformOp:transform"]
        float focalLength = 20
        float horizontalAperture = 18.6523
        float verticalAperture = 18.6523
        float2 clippingRange = (0.01, 100000)
    }

    def Camera "View1"
    {
        matrix4d xformOp:transform = ((1, 0, 0, 0), (0, 0.00731688, 0.999973, 0), (0, -0.999973, 0.00731688, 0), (3, -1, 0.3, 1))
        uniform token[] xformOpOrder = ["xformOp:transform"]
        float focalLength = 20
        float horizontalAperture = 23.094
        float verticalAperture = 23.094
