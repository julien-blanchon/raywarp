#usda 1.0
(
    defaultPrim = "World"
    doc = "Polished / glossy spheres, a mirror-like floor and a clear-coated slab under a 0.53 degree sun."
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def "Looks"
    {
        def Material "Floor"
        {
            token outputs:surface.connect = </World/Looks/Floor/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.05, 0.05, 0.05)
                float inputs:metallic = 0
                float inputs:roughness = 0.02
                token outputs:surface
            }
        }

        def Material "Paint"
        {
            token outputs:surface.connect = </World/Looks/Paint/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 1
                float inputs:clearcoatRoughness = 0.01
                color3f inputs:diffuseColor = (0.5, 0.05, 0.05)
                float inputs:metallic = 0
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "Ball0"
        {
            token outputs:surface.connect = </World/Looks/Ball0/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9, 0.85, 0.75)
                float inputs:metallic = 1
                float inputs:roughness = 0
                token outputs:surface
            }
        }

        def Material "Ball1"
        {
            token outputs:surface.connect = </World/Looks/Ball1/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9, 0.85, 0.75)
                float inputs:metallic = 1
                float inputs:roughness = 0.05
                token outputs:surface
            }
        }

        def Material "Ball2"
        {
            token outputs:surface.connect = </World/Looks/Ball2/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9, 0.85, 0.75)
                float inputs:metallic = 1
                float inputs:roughness = 0.12
                token outputs:surface
            }
        }

        def Material "Ball3"
        {
            token outputs:surface.connect = </World/Looks/Ball3/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.2, 0.6)
                float inputs:metallic = 0
                float inputs:roughness = 0
                token outputs:surface
            }
        }

        def Material "Ball4"
        {
            token outputs:surface.connect = </World/Looks/Ball4/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.2, 0.6)
                float inputs:metallic = 0
                float inputs:roughness = 0.08
                token outputs:surface
            }
        }

        def Material "Ball5"
        {
            token outputs:surface.connect = </World/Looks/Ball5/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.2, 0.6)
                float inputs:metallic = 0
                float inputs:roughness = 0.25
                token outputs:surface
            }
        }
    }

    def Cube "Floor" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/Looks/Floor>
        double size = 1
        float3 xformOp:scale = (20, 20, 0.05)
        double3 xformOp:translate = (0, 0, -0.025)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Slab" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/Looks/Paint>
        double size = 1
        float3 xformOp:scale = (1.2, 1.2, 0.6)
        double3 xformOp:translate = (2.2, 1, 0.3)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Sphere "Ball0" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/Looks/Ball0>
        double radius = 0.35
        double3 xformOp:translate = (-2.5, -1, 0.35)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Sphere "Ball1" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/Looks/Ball1>
        double radius = 0.35
        double3 xformOp:translate = (-1.6, -1, 0.35)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Sphere "Ball2" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/Looks/Ball2>
        double radius = 0.35
        double3 xformOp:translate = (-0.7, -1, 0.35)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Sphere "Ball3" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/Looks/Ball3>
        double radius = 0.35
        double3 xformOp:translate = (0.20000000000000018, -1, 0.35)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Sphere "Ball4" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/Looks/Ball4>
        double radius = 0.35
        double3 xformOp:translate = (1.1, -1, 0.35)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Sphere "Ball5" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/Looks/Ball5>
        double radius = 0.35
        double3 xformOp:translate = (2, -1, 0.35)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def DistantLight "Sun"
    {
        float inputs:angle = 0.53
        float inputs:intensity = 30000
        custom int omni:rtx:usdluxVersion = 2411
        float3 xformOp:rotateXYZ = (-55, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    def Camera "View0"
    {
        float focalLength = 18
        matrix4d xformOp:transform = ( (1, 0, -0, 0), (0, 0.12752174253952617, 0.9918357753074258, 0), (0, -0.9918357753074258, 0.12752174253952617, 0), (0, -5.999999999999999, 1.2, 1) )
        uniform token[] xformOpOrder = ["xformOp:transform"]
    }

    def Camera "View1"
    {
        float focalLength = 18
        matrix4d xformOp:transform = ( (0.9805806756909201, 0.19611613513818407, 3.4694469519536134e-18, 0), (-0.023859893759573907, 0.11929946879786948, 0.9925715803982742, -0), (0.1946593021957089, -0.9732965109785442, 0.12166206387231801, 0), (-1.2, -3, 0.5999999999999999, 0.9999999999999998) )
        uniform token[] xformOpOrder = ["xformOp:transform"]
    }
}

