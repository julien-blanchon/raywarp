#usda 1.0
(
    defaultPrim = "World"
    doc = "A hall under 64 weak IES downlights (measured candela) with pillars."
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def "Looks"
    {
        def Material "Floor"
        {
            token outputs:surface.connect = </World/Looks/Floor/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.55, 0.55)
                float inputs:metallic = 0
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "Pillar"
        {
            token outputs:surface.connect = </World/Looks/Pillar/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.7, 0.68, 0.65)
                float inputs:metallic = 0
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }
    }

    def Cube "Floor" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/Looks/Floor>
        double size = 1
        float3 xformOp:scale = (12, 12, 0.05)
        double3 xformOp:translate = (0, 0, -0.025)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Pillar00" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
