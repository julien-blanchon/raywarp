#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
    doc = """Area lights (LTC): rect, disk, sphere, cylinder of equal intensity straight down (540 cd) over a glossy floor."""
)

def Xform "World"
{
    def Scope "Looks"
    {
        def Material "Wall"
        {
            token outputs:surface.connect = </World/Looks/Wall/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.7, 0.7, 0.7)
                float inputs:roughness = 0.9
                float inputs:metallic = 0
                token outputs:surface
            }
        }

        def Material "GlossyFloor"
        {
            token outputs:surface.connect = </World/Looks/GlossyFloor/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.25, 0.25, 0.25)
                float inputs:roughness = 0.15
                float inputs:metallic = 0
                token outputs:surface
            }
        }

        def Material "Probe"
        {
            token outputs:surface.connect = </World/Looks/Probe/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.8, 0.8)
                float inputs:roughness = 0.4
                float inputs:metallic = 0
                token outputs:surface
            }
        }
    }

    def Cube "Floor" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        double3 xformOp:translate = (0, 0.025, -0.025)
        float3 xformOp:scale = (6.5, 1.65, 0.05)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </World/Looks/GlossyFloor>
    }

    def Cube "Back" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        double3 xformOp:translate = (0, 0.825, 0.8)
        float3 xformOp:scale = (6.5, 0.05, 1.6)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </World/Looks/Wall>
    }

    def Cube "Partition0" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        double3 xformOp:translate = (-3.2, 0, 0.8)
        float3 xformOp:scale = (0.05, 1.6, 1.6)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </World/Looks/Wall>
    }

    def Cube "Partition1" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        double3 xformOp:translate = (-1.6, 0, 0.8)
        float3 xformOp:scale = (0.05, 1.6, 1.6)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </World/Looks/Wall>
    }

    def Cube "Partition2" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        double3 xformOp:translate = (0, 0, 0.8)
        float3 xformOp:scale = (0.05, 1.6, 1.6)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </World/Looks/Wall>
    }

    def Cube "Partition3" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        double3 xformOp:translate = (1.6, 0, 0.8)
        float3 xformOp:scale = (0.05, 1.6, 1.6)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </World/Looks/Wall>
    }

    def Cube "Partition4" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        double3 xformOp:translate = (3.2, 0, 0.8)
        float3 xformOp:scale = (0.05, 1.6, 1.6)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </World/Looks/Wall>
    }

    def Cube "Ceiling" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        double3 xformOp:translate = (0, 0.025, 1.625)
        float3 xformOp:scale = (6.5, 1.65, 0.05)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </World/Looks/Wall>
    }

    def RectLight "Rect"
    {
        float inputs:width = 0.6
        float inputs:height = 0.3
        float inputs:intensity = 3000
        double3 xformOp:translate = (-2.4, 0, 1.3)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Sphere "Probe_RectLight" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 0.18
        double3 xformOp:translate = (-2.7, 0.1, 0.18)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </World/Looks/Probe>
    }

    def Cube "Block_RectLight" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        double3 xformOp:translate = (-2.1, 0.1, 0.2)
        float3 xformOp:scale = (0.3, 0.3, 0.4)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </World/Looks/Probe>
    }

    def DiskLight "Disk"
    {
        float inputs:radius = 0.24
        float inputs:intensity = 2984.16
        double3 xformOp:translate = (-0.8, 0, 1.3)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Sphere "Probe_DiskLight" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 0.18
        double3 xformOp:translate = (-1.1, 0.1, 0.18)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </World/Looks/Probe>
    }

    def Cube "Block_DiskLight" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        double3 xformOp:translate = (-0.5, 0.1, 0.2)
        float3 xformOp:scale = (0.3, 0.3, 0.4)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </World/Looks/Probe>
    }

    def SphereLight "Sphere"
    {
        float inputs:radius = 0.12
        float inputs:intensity = 11936.6
        double3 xformOp:translate = (0.8, 0, 1.3)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Sphere "Probe_SphereLight" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 0.18
        double3 xformOp:translate = (0.5, 0.1, 0.18)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </World/Looks/Probe>
    }

    def Cube "Block_SphereLight" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        double3 xformOp:translate = (1.1, 0.1, 0.2)
        float3 xformOp:scale = (0.3, 0.3, 0.4)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </World/Looks/Probe>
    }

    def CylinderLight "Cylinder"
    {
        float inputs:length = 0.7
        float inputs:radius = 0.03
        float inputs:intensity = 12857.1
        double3 xformOp:translate = (2.4, 0, 1.3)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Sphere "Probe_CylinderLight" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 0.18
        double3 xformOp:translate = (2.1, 0.1, 0.18)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </World/Looks/Probe>
    }

    def Cube "Block_CylinderLight" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        double3 xformOp:translate = (2.7, 0.1, 0.2)
        float3 xformOp:scale = (0.3, 0.3, 0.4)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </World/Looks/Probe>
    }

    def Camera "View0"
    {
        matrix4d xformOp:transform = ((1, 0, 0, 0), (0, 0.0532576, 0.998581, 0), (0, -0.998581, 0.0532576, 0), (0, -7.5, 1, 1))
        uniform token[] xformOpOrder = ["xformOp:transform"]
        float focalLength = 20
        float horizontalAperture = 18.6523
        float verticalAperture = 18.6523
        float2 clippingRange = (0.01, 100000)
    }

    def Camera "View1"
    {
        matrix4d xformOp:transform = ((1, 0, 0, 0), (0, 0.0948091, 0.995495, 0), (0, -0.995495, 0.0948091, 0), (2.4, -1.8, 0.45, 1))
        uniform token[] xformOpOrder = ["xformOp:transform"]
        float focalLength = 20
        float horizontalAperture = 20.8227
        float verticalAperture = 20.8227
        float2 clippingRange = (0.01, 100000)
    }
}
