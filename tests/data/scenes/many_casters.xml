<!-- A room lit by 8 shadow-casting point lights (more casters than any recipe's shadow budget):
     the budget's selection, traced slots and remainder all run at every floor point. A free body
     (the first joint) lets the A/B runner move it. Four cameras. -->
<mujoco model="many_casters">
  <visual>
    <headlight active="0"/>
  </visual>
  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.55 0.55 0.5" rgb2="0.35 0.35 0.32" width="256" height="256"/>
    <material name="floor" texture="grid" texrepeat="6 6"/>
    <material name="gold" rgba="1.0 0.78 0.34 1" specular="1" shininess="0.9" reflectance="0.3"/>
  </asset>
  <worldbody>
    <light pos="-2 -2 2.6" dir="0 0 -1" castshadow="true" cutoff="75" diffuse="0.35 0.33 0.3"/>
    <light pos="0 -2 2.6" dir="0 0 -1" castshadow="true" cutoff="75" diffuse="0.3 0.33 0.35"/>
    <light pos="2 -2 2.6" dir="0 0 -1" castshadow="true" cutoff="75" diffuse="0.35 0.3 0.3"/>
    <light pos="-2 0 2.6" dir="0 0 -1" castshadow="true" cutoff="75" diffuse="0.3 0.35 0.3"/>
    <light pos="2 0 2.6" dir="0 0 -1" castshadow="true" cutoff="75" diffuse="0.33 0.33 0.33"/>
    <light pos="-2 2 2.6" dir="0 0 -1" castshadow="true" cutoff="75" diffuse="0.35 0.33 0.3"/>
    <light pos="0 2 2.6" dir="0 0 -1" castshadow="true" cutoff="75" diffuse="0.3 0.33 0.35"/>
    <light pos="2 2 2.6" dir="0 0 -1" castshadow="true" cutoff="75" diffuse="0.35 0.3 0.3"/>
    <geom name="floor" type="plane" size="4 4 0.1" material="floor"/>
    <geom type="box" pos="0 4 1.5" size="4 0.05 1.5" rgba="0.75 0.72 0.68 1"/>
    <geom type="box" pos="4 0 1.5" size="0.05 4 1.5" rgba="0.72 0.75 0.68 1"/>
    <geom type="box" pos="-1.2 0.6 0.4" size="0.3 0.3 0.4" rgba="0.2 0.4 0.8 1"/>
    <geom type="cylinder" pos="1.1 -0.8 0.5" size="0.25 0.5" rgba="0.8 0.25 0.2 1"/>
    <geom type="sphere" pos="0.9 1.0 0.35" size="0.35" material="gold"/>
    <geom type="capsule" fromto="-1.5 -1.4 0.15 -0.6 -1.0 0.15" size="0.15" rgba="0.3 0.7 0.3 1"/>
    <body name="block" pos="0 0 0.6">
      <freejoint/>
      <geom type="box" size="0.25 0.15 0.35" rgba="0.85 0.85 0.8 1"/>
      <geom type="sphere" pos="0 0 0.5" size="0.15" material="gold"/>
    </body>
    <camera name="c0" pos="0 -4.5 2.4" xyaxes="1 0 0 0 0.45 0.9"/>
    <camera name="c1" pos="3.6 0 2.4" xyaxes="0 1 0 -0.45 0 0.9"/>
    <camera name="c2" pos="-3.5 -3.5 2.0" xyaxes="0.7 -0.7 0 0.3 0.3 0.9"/>
    <camera name="c3" pos="0 0 4.5" xyaxes="1 0 0 0 1 0"/>
  </worldbody>
</mujoco>
