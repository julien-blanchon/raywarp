#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
    doc = """A 32 x 20 m open-plan office under 96 ceiling RectLights (light caps, light ranges, grid culling): desks, partitions, cabinets, glass meeting rooms."""
)

def Xform "World"
{
    def Scope "Looks"
    {
        def Material "Wall"
        {
            token outputs:surface.connect = </World/Looks/Wall/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.7, 0.7, 0.68)
                float inputs:roughness = 0.9
                float inputs:metallic = 0
                token outputs:surface
            }
        }

        def Material "Carpet"
        {
            token outputs:surface.connect = </World/Looks/Carpet/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.25, 0.27, 0.3)
                float inputs:roughness = 0.9
                float inputs:metallic = 0
                token outputs:surface
            }
        }

        def Material "Desk"
        {
            token outputs:surface.connect = </World/Looks/Desk/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.75, 0.6, 0.45)
                float inputs:roughness = 0.5
                float inputs:metallic = 0
                token outputs:surface
            }
        }

        def Material "Cabinet"
        {
            token outputs:surface.connect = </World/Looks/Cabinet/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.6, 0.62, 0.65)
                float inputs:roughness = 0.35
                float inputs:metallic = 1
                token outputs:surface
            }
        }

        def Material "Partition"
        {
            token outputs:surface.connect = </World/Looks/Partition/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.3, 0.35, 0.45)
                float inputs:roughness = 0.8
                float inputs:metallic = 0
                token outputs:surface
            }
        }

        def Material "Glass"
        {
            token outputs:surface.connect = </World/Looks/Glass/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9, 0.95, 1)
                float inputs:roughness = 0.05
                float inputs:metallic = 0
                float inputs:opacity = 0.2
                float inputs:ior = 1.5
                token outputs:surface
            }
        }
    }

