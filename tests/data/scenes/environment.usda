#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
    doc = """Lit only by the sky HDRI (with its sun): env_sun shadows, GI sky visibility, dome orientation."""
)

def Xform "World"
{
    def Scope "Looks"
    {
        def Material "Floor"
        {
            token outputs:surface.connect = </World/Looks/Floor/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.5, 0.5, 0.5)
                float inputs:roughness = 0.8
                float inputs:metallic = 0
                token outputs:surface
            }
        }

        def Material "Object"
        {
            token outputs:surface.connect = </World/Looks/Object/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.8, 0.8)
                float inputs:roughness = 0.5
                float inputs:metallic = 0
                token outputs:surface
            }
        }

        def Material "Chrome"
        {
            token outputs:surface.connect = </World/Looks/Chrome/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.95, 0.95)
                float inputs:roughness = 0.05
                float inputs:metallic = 1
                token outputs:surface
            }
        }
    }

    def Cube "Floor" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        double3 xformOp:translate = (0, 0, -0.025)
        float3 xformOp:scale = (16, 16, 0.05)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </World/Looks/Floor>
    }

    def Cube "Box" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        double3 xformOp:translate = (-0.9, 0, 0.3)
        float3 xformOp:scale = (0.6, 0.6, 0.6)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </World/Looks/Object>
    }

    def Sphere "Ball" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 0.35
        double3 xformOp:translate = (0.2, 0, 0.35)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </World/Looks/Object>
    }

    def Sphere "Chrome" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 0.3
        double3 xformOp:translate = (1.2, 0.2, 0.3)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </World/Looks/Chrome>
    }

    def Cylinder "Post" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 0.05
        double height = 1.5
        uniform token axis = "Z"
        double3 xformOp:translate = (0, 1.2, 0.75)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </World/Looks/Object>
    }

    def DomeLight "Sky"
    {
        custom int omni:rtx:usdluxVersion = 2411
        float inputs:intensity = 1
        asset inputs:texture:file = @./textures/sky.hdr@
        token inputs:texture:format = "latlong"
    }

    def Camera "View0"
    {
        matrix4d xformOp:transform = ((1, 0, 0, 0), (0, 0.253359, 0.967372, 0), (0, -0.967372, 0.253359, 0), (0, -4, 1.5, 1))
        uniform token[] xformOpOrder = ["xformOp:transform"]
        float focalLength = 20
        float horizontalAperture = 18.6523
        float verticalAperture = 18.6523
        float2 clippingRange = (0.01, 100000)
    }

    def Camera "View1"
    {
        matrix4d xformOp:transform = ((0.707107, 0.707107, 0, 0), (-0.457496, 0.457496, 0.762493, 0), (0.539164, -0.539164, 0.646997, 0), (2.5, -2.5, 3, 1))
        uniform token[] xformOpOrder = ["xformOp:transform"]
        float focalLength = 20
        float horizontalAperture = 18.6523
        float verticalAperture = 18.6523
        float2 clippingRange = (0.01, 100000)
    }
}
