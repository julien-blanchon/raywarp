#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
    doc = """A closed room lit only through a window (sky with sun) and a sealed closet behind a 5 cm wall."""
)

def Xform "World"
{
    def Scope "Looks"
    {
        def Material "Wall"
        {
            token outputs:surface.connect = </World/Looks/Wall/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.75, 0.73, 0.7)
                float inputs:roughness = 0.9
                float inputs:metallic = 0
                token outputs:surface
            }
        }

        def Material "Floor"
        {
            token outputs:surface.connect = </World/Looks/Floor/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.4, 0.25)
                float inputs:roughness = 0.6
                float inputs:metallic = 0
                token outputs:surface
            }
        }

        def Material "RedSofa"
        {
            token outputs:surface.connect = </World/Looks/RedSofa/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.7, 0.08, 0.06)
                float inputs:roughness = 0.9
                float inputs:metallic = 0
                token outputs:surface
            }
        }
    }

    def Cube "Floor" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        double3 xformOp:translate = (0, 0, -0.05)
        float3 xformOp:scale = (4.2, 4.2, 0.1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </World/Looks/Floor>
    }

    def Cube "Ceiling" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        double3 xformOp:translate = (0, 0, 2.65)
        float3 xformOp:scale = (4.2, 4.2, 0.1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </World/Looks/Wall>
    }

    def Cube "Back" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        double3 xformOp:translate = (0, 2.05, 1.3)
        float3 xformOp:scale = (4.2, 0.1, 2.6)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </World/Looks/Wall>
    }

    def Cube "Front" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        double3 xformOp:translate = (0, -2.05, 1.3)
        float3 xformOp:scale = (4.2, 0.1, 2.6)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </World/Looks/Wall>
    }

    def Cube "Right" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        double3 xformOp:translate = (2.05, 0, 1.3)
        float3 xformOp:scale = (0.1, 4, 2.6)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </World/Looks/Wall>
    }

    def Cube "LeftA" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        double3 xformOp:translate = (-2.05, -1.3, 1.3)
        float3 xformOp:scale = (0.1, 1.4, 2.6)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </World/Looks/Wall>
    }

    def Cube "LeftB" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        double3 xformOp:translate = (-2.05, 1.3, 1.3)
        float3 xformOp:scale = (0.1, 1.4, 2.6)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </World/Looks/Wall>
    }

    def Cube "LeftSill" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        double3 xformOp:translate = (-2.05, 0, 0.4)
        float3 xformOp:scale = (0.1, 1.2, 0.8)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </World/Looks/Wall>
    }

    def Cube "LeftLintel" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        double3 xformOp:translate = (-2.05, 0, 2.3)
        float3 xformOp:scale = (0.1, 1.2, 0.6)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </World/Looks/Wall>
    }

    def Cube "ClosetWall" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        double3 xformOp:translate = (0.825, 1.4, 1.3)
        float3 xformOp:scale = (0.05, 1.2, 2.6)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </World/Looks/Wall>
    }

    def Cube "ClosetFront" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        double3 xformOp:translate = (1.4, 0.775, 1.3)
        float3 xformOp:scale = (1.2, 0.05, 2.6)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </World/Looks/Wall>
    }

    def Cube "Sofa" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        double3 xformOp:translate = (0, -1.55, 0.25)
        float3 xformOp:scale = (1.6, 0.7, 0.5)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </World/Looks/RedSofa>
    }

    def Cube "Table" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        double3 xformOp:translate = (0, 0.15, 0.725)
        float3 xformOp:scale = (1, 0.7, 0.05)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </World/Looks/Floor>
    }

    def DomeLight "Sky"
    {
        custom int omni:rtx:usdluxVersion = 2411
        float inputs:intensity = 1
        asset inputs:texture:file = @./textures/sky.hdr@
        token inputs:texture:format = "latlong"
        float3 xformOp:rotateXYZ = (0, 0, 150)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    def Camera "View0"
    {
        matrix4d xformOp:transform = ((0.6, 0.8, 0, 0), (-0.219777, 0.164833, 0.961524, 0), (0.769219, -0.576914, 0.274721, 0), (1.8, -1.8, 1.6, 1))
        uniform token[] xformOpOrder = ["xformOp:transform"]
        float focalLength = 20
        float horizontalAperture = 30.6931
        float verticalAperture = 30.6931
        float2 clippingRange = (0.01, 100000)
    }

    def Camera "View1"
    {
        matrix4d xformOp:transform = ((0.695022, -0.718988, 0, 0), (0.102336, 0.098925, 0.989819, 0), (-0.711668, -0.687946, 0.142334, 0), (-1.5, -1.7, 1.4, 1))
        uniform token[] xformOpOrder = ["xformOp:transform"]
        float focalLength = 20
        float horizontalAperture = 30.6931
        float verticalAperture = 30.6931
        float2 clippingRange = (0.01, 100000)
    }

    def Camera "View2"
    {
        matrix4d xformOp:transform = ((-0.707107, 0.707107, 0, 0), (-0.348155, -0.348155, 0.870388, 0), (0.615457, 0.615457, 0.492366, 0), (1.9, 1.9, 1.3, 1))
        uniform token[] xformOpOrder = ["xformOp:transform"]
        float focalLength = 20
        float horizontalAperture = 40
        float verticalAperture = 40
        float2 clippingRange = (0.01, 100000)
    }
}
