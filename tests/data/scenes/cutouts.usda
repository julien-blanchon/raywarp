#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
    doc = """Alpha cutouts: a tiled chain-link fence, a soft-edged decal on a wall and a bush of leaf cards (opacityThreshold 0.5) in the sun."""
)

def Xform "World"
{
    def Scope "Looks"
    {
        def Material "Floor"
        {
            token outputs:surface.connect = </World/Looks/Floor/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.6, 0.6, 0.6)
                float inputs:roughness = 0.8
                float inputs:metallic = 0
                token outputs:surface
            }
        }

        def Material "Checker"
        {
            token outputs:surface.connect = </World/Looks/Checker/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </World/Looks/Checker/Tex_diffuseColor.outputs:rgb>
                float inputs:roughness = 0.8
                float inputs:metallic = 0
                token outputs:surface
            }

            def Shader "St"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Tex_diffuseColor"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/checker.png@
                float2 inputs:st.connect = </World/Looks/Checker/St.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                token inputs:sourceColorSpace = "auto"
                float3 outputs:rgb
            }
        }

        def Material "Fence"
        {
            token outputs:surface.connect = </World/Looks/Fence/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </World/Looks/Fence/Tex_diffuseColor.outputs:rgb>
                float inputs:roughness = 0.4
                float inputs:metallic = 0.8
                float inputs:opacityThreshold = 0.5
                float inputs:opacity.connect = </World/Looks/Fence/Tex_opacity.outputs:a>
                token outputs:surface
            }

            def Shader "St"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Tile"
            {
                uniform token info:id = "UsdTransform2d"
                float2 inputs:in.connect = </World/Looks/Fence/St.outputs:result>
                float2 inputs:scale = (6, 6)
                float2 outputs:result
            }

            def Shader "Tex_diffuseColor"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/fence.png@
                float2 inputs:st.connect = </World/Looks/Fence/Tile.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                token inputs:sourceColorSpace = "auto"
                float3 outputs:rgb
            }

            def Shader "Tex_opacity"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/fence.png@
                float2 inputs:st.connect = </World/Looks/Fence/Tile.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                token inputs:sourceColorSpace = "raw"
                float outputs:a
            }
        }

        def Material "Decal"
        {
            token outputs:surface.connect = </World/Looks/Decal/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </World/Looks/Decal/Tex_diffuseColor.outputs:rgb>
                float inputs:roughness = 0.6
                float inputs:metallic = 0
                float inputs:opacityThreshold = 0.5
                float inputs:opacity.connect = </World/Looks/Decal/Tex_opacity.outputs:a>
                token outputs:surface
            }

            def Shader "St"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Tex_diffuseColor"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/decal.png@
                float2 inputs:st.connect = </World/Looks/Decal/St.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                token inputs:sourceColorSpace = "auto"
                float3 outputs:rgb
            }

            def Shader "Tex_opacity"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/decal.png@
                float2 inputs:st.connect = </World/Looks/Decal/St.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                token inputs:sourceColorSpace = "raw"
                float outputs:a
            }
        }

        def Material "Leaf"
        {
            token outputs:surface.connect = </World/Looks/Leaf/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </World/Looks/Leaf/Tex_diffuseColor.outputs:rgb>
                float inputs:roughness = 0.7
                float inputs:metallic = 0
                float inputs:opacityThreshold = 0.5
                float inputs:opacity.connect = </World/Looks/Leaf/Tex_opacity.outputs:a>
                token outputs:surface
            }

            def Shader "St"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Tex_diffuseColor"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/leaf.png@
                float2 inputs:st.connect = </World/Looks/Leaf/St.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                token inputs:sourceColorSpace = "auto"
                float3 outputs:rgb
            }

            def Shader "Tex_opacity"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/leaf.png@
                float2 inputs:st.connect = </World/Looks/Leaf/St.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                token inputs:sourceColorSpace = "raw"
                float outputs:a
            }
        }
    }

    def Cube "Floor" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        double3 xformOp:translate = (0, 0.5, -0.025)
        float3 xformOp:scale = (8, 7, 0.05)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </World/Looks/Floor>
    }

    def Mesh "Wall" (
        prepend apiSchemas = ["MaterialBindingAPI"]
