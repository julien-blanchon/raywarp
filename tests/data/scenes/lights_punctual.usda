    }

    def SphereLight "Light3"
    {
        float inputs:radius = 0.01
        float inputs:intensity = 381972
        bool inputs:enableColorTemperature = 1
        float inputs:colorTemperature = 2700
        double3 xformOp:translate = (0.6, 0, 1.3)
        float3 xformOp:rotateXYZ = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    def Sphere "Probe3" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 0.15
        double3 xformOp:translate = (0.6, 0.15, 0.15)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </World/Looks/Probe>
    }

    def SphereLight "Light4"
    {
        float inputs:radius = 0.01
        float inputs:intensity = 381972
        bool inputs:enableColorTemperature = 1
        float inputs:colorTemperature = 4000
        double3 xformOp:translate = (1.8, 0, 1.3)
        float3 xformOp:rotateXYZ = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    def Sphere "Probe4" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 0.15
        double3 xformOp:translate = (1.8, 0.15, 0.15)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </World/Looks/Probe>
    }

    def SphereLight "Light5"
    {
        float inputs:radius = 0.01
        float inputs:intensity = 381972
        bool inputs:enableColorTemperature = 1
        float inputs:colorTemperature = 6500
        double3 xformOp:translate = (3, 0, 1.3)
        float3 xformOp:rotateXYZ = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    def Sphere "Probe5" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 0.15
        double3 xformOp:translate = (3, 0.15, 0.15)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </World/Looks/Probe>
    }

    def Camera "View0"
    {
        matrix4d xformOp:transform = ((1, 0, 0, 0), (0, 0.0352722, 0.999378, 0), (0, -0.999378, 0.0352722, 0), (0, -8.5, 0.9, 1))
        uniform token[] xformOpOrder = ["xformOp:transform"]
        float focalLength = 20
        float horizontalAperture = 18.6523
        float verticalAperture = 18.6523
        float2 clippingRange = (0.01, 100000)
    }

    def Camera "View1"
    {
        matrix4d xformOp:transform = ((1, 0, 0, 0), (0, 0.159232, 0.987241, 0), (0, -0.987241, 0.159232, 0), (-1.8, -2.8, 0.9, 1))
        uniform token[] xformOpOrder = ["xformOp:transform"]
        float focalLength = 20
        float horizontalAperture = 18.6523
        float verticalAperture = 18.6523
