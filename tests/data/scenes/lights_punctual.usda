    def Cube "Ceiling" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        double3 xformOp:translate = (0, 0.025, 1.525)
        float3 xformOp:scale = (7.3, 1.45, 0.05)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </World/Looks/Wall>
    }

    def SphereLight "Light0"
    {
        float inputs:radius = 0.01
        float inputs:intensity = 381972
        bool inputs:treatAsPoint = 1
        double3 xformOp:translate = (-3, 0, 1.3)
        float3 xformOp:rotateXYZ = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    def Sphere "Probe0" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 0.15
        double3 xformOp:translate = (-3, 0.15, 0.15)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </World/Looks/Probe>
    }

    def SphereLight "Light1" (
        prepend apiSchemas = ["ShapingAPI"]
    )
    {
        float inputs:radius = 0.01
        float inputs:intensity = 381972
        float inputs:shaping:cone:angle = 25
        float inputs:shaping:cone:softness = 0
        double3 xformOp:translate = (-1.8, 0, 1.3)
        float3 xformOp:rotateXYZ = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    def Sphere "Probe1" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 0.15
        double3 xformOp:translate = (-1.8, 0.15, 0.15)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </World/Looks/Probe>
    }

    def SphereLight "Light2" (
