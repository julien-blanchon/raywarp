        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </World/Looks/Wall>
    }

    def Cube "Partition5" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        double3 xformOp:translate = (2.4, 0, 0.75)
        float3 xformOp:scale = (0.05, 1.4, 1.5)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </World/Looks/Wall>
    }

    def Cube "Partition6" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        double3 xformOp:translate = (3.6, 0, 0.75)
        float3 xformOp:scale = (0.05, 1.4, 1.5)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </World/Looks/Wall>
