#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
    doc = """Meshes: flat / smooth / no normals, with and without UVs, n-gons, mirrored and open double-sided meshes."""
)

def Xform "World"
{
    def Scope "Looks"
    {
        def Material "Floor"
        {
            token outputs:surface.connect = </World/Looks/Floor/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.5, 0.5, 0.5)
                float inputs:roughness = 0.8
                float inputs:metallic = 0
                token outputs:surface
            }
        }

        def Material "Grey"
        {
            token outputs:surface.connect = </World/Looks/Grey/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.7, 0.7, 0.7)
                float inputs:roughness = 0.35
                float inputs:metallic = 0
                token outputs:surface
            }
        }

        def Material "UVGrid"
        {
            token outputs:surface.connect = </World/Looks/UVGrid/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </World/Looks/UVGrid/Tex_diffuseColor.outputs:rgb>
                float inputs:roughness = 0.5
                float inputs:metallic = 0
                token outputs:surface
            }

            def Shader "St"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Tex_diffuseColor"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/uvgrid.png@
                float2 inputs:st.connect = </World/Looks/UVGrid/St.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                token inputs:sourceColorSpace = "auto"
                float3 outputs:rgb
            }
        }
    }

    def Cube "Floor" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        double3 xformOp:translate = (0, 0.5, -0.025)
        float3 xformOp:scale = (6, 5, 0.05)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </World/Looks/Floor>
    }

    def Mesh "IcoFlat" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-0.35, -0.35, -0.35), (0.35, 0.35, 0.35)]
