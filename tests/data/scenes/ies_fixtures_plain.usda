#usda 1.0
(
    defaultPrim = "World"
    doc = "Six IES luminaires (axial, quadrant, asymmetric, bilateral, type B flood, rect panel) over white cells."
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def "Looks"
    {
        def Material "Wall"
        {
            token outputs:surface.connect = </World/Looks/Wall/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.75, 0.75, 0.75)
                float inputs:metallic = 0
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }

        def Material "Floor"
        {
            token outputs:surface.connect = </World/Looks/Floor/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.5, 0.5, 0.5)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "Probe"
        {
            token outputs:surface.connect = </World/Looks/Probe/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.8, 0.8)
                float inputs:metallic = 0
                float inputs:roughness = 0.25
                token outputs:surface
            }
        }
    }

    def Cube "Floor" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/Looks/Floor>
        double size = 1
        float3 xformOp:scale = (12.6, 4, 0.05)
        double3 xformOp:translate = (0, 0, -0.025)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Back" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/Looks/Wall>
        double size = 1
        float3 xformOp:scale = (12.6, 0.05, 2.8)
        double3 xformOp:translate = (0, 1.5, 1.4)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Divider0" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/Looks/Wall>
        double size = 1
        float3 xformOp:scale = (0.05, 2.5, 2.8)
        double3 xformOp:translate = (-6.3, 0.25, 1.4)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def SphereLight "Light0" (
        prepend apiSchemas = ["ShapingAPI"]
    )
    {
        float inputs:intensity = 95492.97
        float inputs:radius = 0.02
        float inputs:shaping:cone:angle = 180
        bool treatAsPoint = 1
        float3 xformOp:rotateXYZ = (0, 0, 0)
        double3 xformOp:translate = (-5.25, 0.3, 2.2)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
