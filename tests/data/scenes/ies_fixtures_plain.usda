    def Camera "View0"
    {
        float focalLength = 18
        matrix4d xformOp:transform = ( (1, 0, -0, 0), (0, 0.07478994824163424, 0.9971993098884564, 0), (0, -0.9971993098884564, 0.07478994824163424, 0), (0, -7.5, 1.6, 1) )
