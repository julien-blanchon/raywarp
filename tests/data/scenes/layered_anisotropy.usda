#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
    doc = """Brushed metal (OpenPBR specular_roughness_anisotropy): spheres a = 0 / 0.5 / 0.9 / 0.9 turned 90 degrees (standard_surface specular_rotation), a cylinder, a thin disc and a UV-sphere mesh at a = 0.8, under a small sphere light and a dim studio dome."""
)

def Xform "World"
{
    def Scope "Looks"
    {
        def Material "Floor"
        {
            token outputs:surface.connect = </World/Looks/Floor/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.08, 0.08, 0.08)
                float inputs:roughness = 0.5
                float inputs:metallic = 0
                token outputs:surface
            }
        }

        def Material "Aniso0"
        {
            token outputs:mtlx:surface.connect = </World/Looks/Aniso0/Surface.outputs:out>

            def Shader "Surface"
            {
                uniform token info:id = "ND_open_pbr_surface_surfaceshader"
                color3f inputs:base_color = (0.95, 0.93, 0.88)
                float inputs:base_metalness = 1
                float inputs:specular_roughness = 0.3
                float inputs:specular_roughness_anisotropy = 0
                token outputs:out
            }
        }

        def Material "Aniso1"
        {
            token outputs:mtlx:surface.connect = </World/Looks/Aniso1/Surface.outputs:out>

            def Shader "Surface"
            {
                uniform token info:id = "ND_open_pbr_surface_surfaceshader"
                color3f inputs:base_color = (0.95, 0.93, 0.88)
                float inputs:base_metalness = 1
                float inputs:specular_roughness = 0.3
                float inputs:specular_roughness_anisotropy = 0.5
                token outputs:out
            }
        }

        def Material "Aniso2"
        {
            token outputs:mtlx:surface.connect = </World/Looks/Aniso2/Surface.outputs:out>

            def Shader "Surface"
            {
                uniform token info:id = "ND_open_pbr_surface_surfaceshader"
                color3f inputs:base_color = (0.95, 0.93, 0.88)
                float inputs:base_metalness = 1
                float inputs:specular_roughness = 0.3
                float inputs:specular_roughness_anisotropy = 0.9
                token outputs:out
            }
        }

        def Material "AnisoTurned"
        {
            token outputs:mtlx:surface.connect = </World/Looks/AnisoTurned/Surface.outputs:out>

            def Shader "Surface"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                float inputs:base = 1
                color3f inputs:base_color = (0.95, 0.93, 0.88)
                float inputs:metalness = 1
                float inputs:specular_roughness = 0.3
                float inputs:specular_anisotropy = 0.9
                float inputs:specular_rotation = 0.25
                token outputs:out
            }
        }

        def Material "Brushed"
        {
            token outputs:mtlx:surface.connect = </World/Looks/Brushed/Surface.outputs:out>

            def Shader "Surface"
            {
                uniform token info:id = "ND_open_pbr_surface_surfaceshader"
                color3f inputs:base_color = (0.95, 0.93, 0.88)
                float inputs:base_metalness = 1
                float inputs:specular_roughness = 0.3
                float inputs:specular_roughness_anisotropy = 0.8
                token outputs:out
            }
        }
    }

    def Cube "Floor" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1
        double3 xformOp:translate = (0, 0.25, -0.01)
        float3 xformOp:scale = (6, 5.5, 0.02)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </World/Looks/Floor>
    }

    def Sphere "Sphere_A0" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 0.3
        double3 xformOp:translate = (-1.8, 0.4, 0.3)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </World/Looks/Aniso0>
    }

    def Sphere "Sphere_A1" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 0.3
        double3 xformOp:translate = (-1, 0.4, 0.3)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </World/Looks/Aniso1>
    }

    def Sphere "Sphere_A2" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 0.3
        double3 xformOp:translate = (-0.2, 0.4, 0.3)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </World/Looks/Aniso2>
    }

    def Sphere "Sphere_Turned" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 0.3
        double3 xformOp:translate = (0.6, 0.4, 0.3)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </World/Looks/AnisoTurned>
    }

    def Cylinder "Cylinder" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 0.25
        double height = 0.7
        uniform token axis = "Z"
        double3 xformOp:translate = (1.5, 0.4, 0.35)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </World/Looks/Brushed>
    }

    def Cylinder "Disc" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double radius = 0.35
        double height = 0.006
        uniform token axis = "Z"
        double3 xformOp:translate = (-0.6, -0.6, 0.003)
        uniform token[] xformOpOrder = ["xformOp:translate"]
