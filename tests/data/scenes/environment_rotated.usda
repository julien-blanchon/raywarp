#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
    doc = """The environment scene with the dome turned 90 degrees about +Z."""
    subLayers = [@./environment.usda@]
)

over "World"
{
    over "Sky"
    {
        float3 xformOp:rotateXYZ = (0, 0, 90)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    def Camera "View0"
    {
        matrix4d xformOp:transform = ((1, 0, 0, 0), (0, 0.253359, 0.967372, 0), (0, -0.967372, 0.253359, 0), (0, -4, 1.5, 1))
        uniform token[] xformOpOrder = ["xformOp:transform"]
        float focalLength = 20
        float horizontalAperture = 18.6523
        float verticalAperture = 18.6523
        float2 clippingRange = (0.01, 100000)
    }

    def Camera "View1"
    {
        matrix4d xformOp:transform = ((0.707107, 0.707107, 0, 0), (-0.457496, 0.457496, 0.762493, 0), (0.539164, -0.539164, 0.646997, 0), (2.5, -2.5, 3, 1))
        uniform token[] xformOpOrder = ["xformOp:transform"]
        float focalLength = 20
        float horizontalAperture = 18.6523
        float verticalAperture = 18.6523
        float2 clippingRange = (0.01, 100000)
    }
}
