+// special handling for: mi::neuraylib::ILogging_configuration (added by raywarp-mdl)
+// ----------------------------------------------------------------------------
+// The log level only: the loggers (ILogger is not wrapped) and the per-category / prefix /
+// priority settings are ignored. The level crosses as an int (a Message_severity value).
+%ignore mi::neuraylib::ILogging_configuration::set_receiving_logger;
+%ignore mi::neuraylib::ILogging_configuration::get_receiving_logger;
+%ignore mi::neuraylib::ILogging_configuration::get_forwarding_logger;
+%ignore mi::neuraylib::ILogging_configuration::set_log_level;
+%ignore mi::neuraylib::ILogging_configuration::get_log_level;
+%ignore mi::neuraylib::ILogging_configuration::set_log_level_by_category;
+%ignore mi::neuraylib::ILogging_configuration::get_log_level_by_category;
+%ignore mi::neuraylib::ILogging_configuration::set_log_prefix;
+%ignore mi::neuraylib::ILogging_configuration::get_log_prefix;
+%ignore mi::neuraylib::ILogging_configuration::set_log_priority;
+%ignore mi::neuraylib::ILogging_configuration::get_log_priority;
+%ignore mi::neuraylib::ILogging_configuration::set_log_locally;
+%ignore mi::neuraylib::ILogging_configuration::get_log_locally;
+// The prefix flags belong to the ignored set_log_prefix (post_swig.py rejects unhandled globals).
+%ignore mi::neuraylib::Log_prefix;
+%ignore mi::neuraylib::LOG_PREFIX_TIME;
+%ignore mi::neuraylib::LOG_PREFIX_TIME_SECONDS;
+%ignore mi::neuraylib::LOG_PREFIX_HOST_THREAD;
+%ignore mi::neuraylib::LOG_PREFIX_HOST_NAME;
+%ignore mi::neuraylib::LOG_PREFIX_MODULE;
+%ignore mi::neuraylib::LOG_PREFIX_CATEGORY;
+%ignore mi::neuraylib::LOG_PREFIX_SEVERITY;
+%ignore mi::neuraylib::LOG_PREFIX_CUDA_DEVICE;
+%ignore mi::neuraylib::LOG_PREFIX_TAGS;
+%extend SmartPtr<mi::neuraylib::ILogging_configuration> {
+    mi::Sint32 set_log_level_value(mi::Sint32 level)
+    {
+        return $self->get()->set_log_level(static_cast<mi::base::Message_severity>(level));
+    }
+    mi::Sint32 get_log_level_value() const
+    {
+        return static_cast<mi::Sint32>($self->get()->get_log_level());
+    }
+}
