# The pinned inputs of every HF job and sandbox and of the native wheel builds: the one place they
# are written down. Read by tools/hf/entry.sh and tools/native/common.sh (sourced: plain KEY=value
# lines, values without spaces unless quoted, no variable references), tools/hf/config.py and the
# tests. Paths are on the bucket mount (/data).

# Container image of jobs and sandboxes (CPU and GPU: one environment).
IMAGE=nvidia/cuda:12.8.1-devel-ubuntu24.04
PYTHON=3.12
# uv 0.13.6, a static binary (no install script download).
UV_BIN=/data/pins/hyperlux-office-v1/uv
# The native build hook's inputs (versions, URLs, sha256: tools/native/hook.py, their one source):
# the pinned NVIDIA artifacts pre-fetched here (`python tools/native/hook.py fetch DIR`), and the
# cache of compiled MDL bindings (by build key) every job shares. raywarp needs no other wheel
# (OptiX: its ctypes binding over the driver).
NATIVE_ARCHIVES=/data/pins/native
NATIVE_CACHE=/data/sdk/native-hook
OPTIX_HEADERS=/data/pins/hyperlux-office-v1/optix_dev.tgz
# Omniverse RTX (`--with ovrtx`: references through Newton's ViewerRTX / ovrtx).
OVRTX_PACKAGES="ovrtx==0.5.1.* ovstage==0.2.1.*"
OVRTX_INDEX=https://pypi.nvidia.com
# The kernel fill's NVRTC and nvJitLink (`--with fillcuda`: every Warp shard of
# tools/prebuilt/fill_all.sh; tools/prebuilt/software.py links the software path's word modules
# with them): Warp's own CUDA version (warp-lang 1.18: CUDA 13.4; an LTO-IR must not be newer than
# its linker, `software._cuda` checks it).
FILL_CUDA_PACKAGES="nvidia-cuda-nvrtc==13.4.* nvidia-nvjitlink==13.4.*"
# The mjlab + HyperLux environment (`--env mjlab`, the A/B runner's competitor environment).
MJLAB_PINS=/data/pins/hyperlux-office-v1
MJLAB_COMMIT=8bb2bc9e187797689ec82c78c35019afd2fd0376
PLUGIN_COMMIT=edc49e04d6f924bc93629accf11a85eaf03fd826
HYPERLUX_VERSION=0.1.8
USD_CORE=usd-core==26.8
