# The storage buckets of the prebuilt kernels: the one place their names are written down. Read by
# tools/prebuilt/fill_all.sh (sourced: plain KEY=value lines), tools/prebuilt/build_cache.py,
# .github/workflows/kernels.yml and the tests (raywarp/core/build/kernel_cache/store.BUCKET, the
# runtime's default remote, must equal KERNELS_BUCKET: tests/tooling/test_build_cache.py).
#
# KERNELS_BUCKET: public, the releases' bundles and OptiX module packs the renderer downloads
#   (sm<arch>/<content>/..., optix/<driver>/...: tools/release/kernels.py publish; never rewritten).
# CACHE_BUCKET: private, the build cache of the fill (content-addressed, immutable entries, pruned
#   to what the last releases reference: tools/prebuilt/build_cache.py), mounted at /cache in every
#   fill job.
# ASSETS_BUCKET: public, the benchmark scenes (benchmarks/v<format>-c<converter>/: the prepared
#   .rayw files, the MJCF archive, their cameras, the USD sources, their licences;
#   tools/release/benchmark_scenes.py publish, benchmarks/run.py downloads; never rewritten).
# PROJECT_BUCKET: the HF jobs' bucket (/data: the code archives, the hand-over archives, spend).
KERNELS_BUCKET=blanchon/raywarp-kernels
CACHE_BUCKET=blanchon/raywarp-build-cache
ASSETS_BUCKET=blanchon/raywarp-assets
PROJECT_BUCKET=blanchon/mujoco-warp-pbr
